# ---------------------------------------------------------------------------
# Pipeline environment configuration (copy to .env and fill in values).
# Never commit .env — this example documents every variable the project reads.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
ENVIRONMENT=local            # local | staging | production

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Processing ------------------------------------------------------------
# Default date range used when no CLI arguments are supplied.
DEFAULT_START_DATE=2025-01-01
DEFAULT_END_DATE=2025-01-31
# Number of partitions/files processed in parallel.
WORKERS=4
# Restart/backoff policy for downloads and tasks.
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# --- Storage (object store + local filesystem) -----------------------------
STORAGE_BACKEND=local        # local | minio | s3
DATA_DIR=./data              # local filesystem root (raw/staging/curated/marts)

# MinIO / S3-compatible object storage.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw
MINIO_SECURE=false
AWS_ENDPOINT_URL=            # production S3 endpoint override
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Serving database (PostgreSQL) -----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taxi
POSTGRES_USER=taxi
POSTGRES_PASSWORD=taxi

# --- DuckDB (local analytics / dbt) ----------------------------------------
DUCKDB_PATH=./data/analytics.duckdb

# --- dbt -------------------------------------------------------------------
DBT_PROFILES_DIR=./dbt
DBT_PROJECT_DIR=./dbt
DBT_TARGET=dev

# --- Airflow ---------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=false

# --- Dashboard / API -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# --- Data quality thresholds ------------------------------------------------
QUALITY_MAX_INVALID_RATIO=0.20   # fail validation if invalid rows exceed this
QUALITY_MAX_NULL_RATIO=0.10      # fail validation if critical nulls exceed this

# --- Alerts -----------------------------------------------------------------
ALERT_ROW_CHANGE_RATIO=2.0       # warn when input rows change by this factor
ALERT_MAX_DURATION_SECONDS=3600  # warn when a run exceeds this duration

# --- Metrics ---------------------------------------------------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Data sources ----------------------------------------------------------
# URLs are also declared in config/sources.yaml; env overrides win here.
TAXI_TRIPS_URL=https://d37ci6vzurychx.cloudfront.net/trip-data/yellow_tripdata_{year}-{month:02d}.parquet
TAXI_ZONES_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi+_zone_lookup.csv
WEATHER_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_LATITUDE=40.7143
WEATHER_LONGITUDE=-74.0060
